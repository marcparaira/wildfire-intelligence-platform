# Build from the repository root so the shared events package is in the context:
#   podman build -f apps/api/Containerfile .
FROM docker.io/library/python:3.12-alpine AS build

WORKDIR /build
COPY packages/events ./packages/events
COPY apps/api/pyproject.toml apps/api/README.md ./apps/api/
COPY apps/api/src ./apps/api/src
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir ./packages/events ./apps/api

FROM docker.io/library/python:3.12-alpine AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apk add --no-cache libstdc++ \
    && addgroup -S app && adduser -S -G app app
COPY --from=build /opt/venv /opt/venv
COPY apps/api/healthcheck.py /app/healthcheck.py
WORKDIR /app
USER app
EXPOSE 8000
CMD ["uvicorn", "wildfire_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
