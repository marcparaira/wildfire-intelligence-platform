# Build from the repository root so the shared events package is in the context:
#   podman build -f services/stream-processor/Containerfile .
# Debian-based: confluent-kafka and rocksdict (used by Quix Streams) publish no musl wheels.
FROM docker.io/library/python:3.12-slim AS build

WORKDIR /build
COPY packages/events ./packages/events
COPY services/stream-processor/pyproject.toml ./services/stream-processor/
COPY services/stream-processor/src ./services/stream-processor/src
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir ./packages/events ./services/stream-processor

FROM docker.io/library/python:3.12-slim AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    STATE_DIR=/app/state

RUN groupadd --system app && useradd --system --gid app --home-dir /app app \
    && mkdir -p /app/state && chown -R app:app /app
COPY --from=build /opt/venv /opt/venv
WORKDIR /app
USER app
CMD ["python", "-m", "wildfire_processor"]
